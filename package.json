{
  "name": "meowdler",
  "productName": "Meowdler",
  "version": "0.2.3",
  "private": true,
  "description": "Catppuccin-themed desktop downloader for YouTube, X, and Instagram",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "build": {
    "appId": "dev.meowdler.app",
    "productName": "Meowdler",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "MB-PieSec",
        "repo": "meowdler"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "yt-dlp",
          "ffmpeg"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf out dist node_modules/.vite",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "fetch:ffmpeg": "bash scripts/fetch-ffmpeg.sh"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "author": {
    "name": "MB-PieSec",
    "email": "MB-PieSec@users.noreply.github.com"
  },
  "homepage": "https://github.com/MB-PieSec/meowdler",
  "linux": {
    "syncDesktopName": "true"
  },
  "desktopName": "Meowdler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MB-PieSec/meowdler.git"
  }
}
